package threads;

public class TestSubject3 { 
	
	public static void main(String[] args) {
		MSWord ms1 = new MSWord();
		MSWord ms2 = new MSWord();
		MSWord ms3 = new MSWord();
		
		ms1.setName("TYPE");
		ms2.setName("SPELL");
		ms3.setName("SAVE");
		
//		ms2.setPriority(5);
		ms3.setPriority(1);
		
		ms3.setDaemon(true);
		
		ms1.start();
		ms2.start();
		ms3.start();
		
	}

}


class MSWord extends Thread {
	
	String name;
	
	public void run() {
		name = Thread.currentThread().getName();
		
		if (name.equals("TYPE")) {
			typing();
		} else if (name.equals("SPELL")) {
			spelling();
		} else if (name.equals("SAVE")) {
			autoSave();
		}
	}
	
	
	public void typing () {
		for (int i = 0; i < 5; i++) {
			System.out.println("User is typing.");
			try {
				Thread.sleep(1000);
			} catch (InterruptedException e) {
				e.printStackTrace();
			}
		}
	}
	
	public void spelling () {
		for (int i = 0; i < 5; i++) {
			System.out.println("Checking the spell check");
			try {
				Thread.sleep(1000);
			} catch (InterruptedException e) {
				e.printStackTrace();
			}
		}
	}
	
	public void autoSave () {
		for ( ; ; ) {
			System.out.println("AuotSaved");
			try {
				Thread.sleep(1000);
			} catch (InterruptedException e) {
				e.printStackTrace();
			}
		}
	}
}
